# =============================================================================
# Production template. Copy to .env and fill in real values.
# NEVER commit a filled-in .env — it is git-ignored for a reason.
# =============================================================================

DEMO_MODE=false

# --- Authentication (REQUIRED in production) ----------------------------------
# With API_AUTH_ENABLED=true, POST /incidents, POST /incidents/{id}/approve,
# POST /eval/run and POST /spec/generate all require:
#     Authorization: Bearer <API_SECRET_KEY>
# The server refuses to start serving those routes if the key is a placeholder.
API_AUTH_ENABLED=true
API_SECRET_KEY=generate-with-openssl-rand-hex-32
# Shown in the dashboard footer.
REPO_URL=https://github.com/your-org/crisis-squad

CORS_ALLOW_ORIGINS=https://crisis-squad.your-domain.internal

# --- LLM ----------------------------------------------------------------------
LLM_MODEL=openai/gpt-4o-mini
LLM_FAST_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=45
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# LLM_BASE_URL=            # OpenAI-compatible gateway, if any
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- LangSmith tracing (optional) ---------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=gcb-crisis-squad

# --- Instana ------------------------------------------------------------------
INSTANA_BASE_URL=https://your-instance.instana.io
INSTANA_API_TOKEN=your_instana_api_token

# --- Jira ---------------------------------------------------------------------
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER_EMAIL=you@your-org.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=KAN

# --- Microsoft Teams ----------------------------------------------------------
TEAMS_TENANT_ID=your_tenant_id
TEAMS_CLIENT_ID=your_client_id
TEAMS_CLIENT_SECRET=your_client_secret
TEAMS_TEAM_ID=your_team_id
TEAMS_ONCALL_EMAILS=sre1@your-org.com,sre2@your-org.com

# --- Knowledge base -----------------------------------------------------------
KB_DOCS_DIR=./docs/runbooks
KB_PERSIST_DIR=./data/faiss_index

# --- API ----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
