# =============================================================================
# DEMO MODE — every external integration is simulated locally.
# No real credentials are required. Copy this file to .env to run the demo:
#     cp .env.demo .env
# =============================================================================

# Mocks Instana, Jira and Teams. No outbound calls to those systems.
DEMO_MODE=true

# --- Authentication -----------------------------------------------------------
# Disabled for the local demo so the dashboard works with no setup.
# In any shared or production deployment set API_AUTH_ENABLED=true and a real
# API_SECRET_KEY — the /incidents and /approve endpoints are then bearer-guarded.
API_AUTH_ENABLED=false
API_SECRET_KEY=change-me-in-production

# --- LLM ----------------------------------------------------------------------
# The playbook node is the only LLM call. Without a key the system still runs
# end to end using a deterministic fallback playbook.
#
# OPTION A: Groq (free tier, very fast) — https://console.groq.com
GROQ_API_KEY=
LLM_MODEL=groq/qwen/qwen3.6-27b
LLM_FAST_MODEL=groq/qwen/qwen3.6-27b
#
# OPTION B: OpenAI
# OPENAI_API_KEY=sk-...
# LLM_MODEL=openai/gpt-4o-mini
# LLM_FAST_MODEL=openai/gpt-4o-mini
#
# OPTION C: Ollama (fully local, no key). Requires `ollama serve` running.
# LLM_MODEL=ollama/llama3.2
# LLM_FAST_MODEL=ollama/llama3.2
# OLLAMA_BASE_URL=http://localhost:11434/v1
#
# OPTION D: any OpenAI-compatible gateway (LiteLLM proxy, vLLM, Azure)
# LLM_MODEL=my-gateway-model
# LLM_BASE_URL=http://localhost:4000/v1
# OPENAI_API_KEY=whatever-your-gateway-expects

LLM_TIMEOUT_SECONDS=45

# --- LangSmith tracing (optional) ---------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=gcb-crisis-squad

# --- Instana — ignored while DEMO_MODE=true -----------------------------------
INSTANA_BASE_URL=https://demo.instana.io
INSTANA_API_TOKEN=demo-token

# --- Jira — ignored while DEMO_MODE=true --------------------------------------
JIRA_BASE_URL=https://demo.atlassian.net
JIRA_USER_EMAIL=demo@example.com
JIRA_API_TOKEN=demo-token
JIRA_PROJECT_KEY=KAN

# --- Microsoft Teams — ignored while DEMO_MODE=true ---------------------------
TEAMS_TENANT_ID=demo-tenant
TEAMS_CLIENT_ID=demo-client
TEAMS_CLIENT_SECRET=demo-secret
TEAMS_TEAM_ID=demo-team

# --- Knowledge base -----------------------------------------------------------
KB_DOCS_DIR=./docs/runbooks
KB_PERSIST_DIR=./data/faiss_index

# --- API ----------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Shown in the dashboard footer.
REPO_URL=https://github.com/rodrigochad04/crisis-squad

CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
